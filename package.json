{
  "name": "ioa-rg",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/copy-static.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --exclude firestore.rules.test.ts",
    "test:static": "node scripts/check-static.mjs",
    "test:emulator": "firebase emulators:exec --project demo-ioa-rang --only firestore \"npx vitest run firestore.rules.test.ts\""
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
